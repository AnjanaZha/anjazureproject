{
	"name": "incremental_load_bronze",
	"properties": {
		"activities": [
			{
				"name": "Lookup_new_KB",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM [dbo].[metadata]",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlmetadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "For-over-tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_new_KB",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_new_KB').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Lookup-max-value",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT * FROM [dbo].[metadata] WHERE TableName = '@{item().TableName}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlmetadata",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check_New_Data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(int(activity('Check_New_Data').output.firstRow.NewRowCount), 0)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "ingestion",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat('SELECT * FROM [dbo].[', item().TableName, '] WHERE LoadDateTime > ''', coalesce(formatDateTime(activity('Lookup-max-value').output.firstRow.WatermarkValue, 'yyyy-MM-dd HH:mm:ss.fff'), '1900-01-01 00:00:00.000'), '''')",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings",
													"copyBehavior": "FlattenHierarchy"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "Sql_KB_tables",
												"type": "DatasetReference"
											}
										],
										"outputs": [
											{
												"referenceName": "Ds_UserData_Blob_Sink",
												"type": "DatasetReference",
												"parameters": {
													"fileName": {
														"value": "@concat(item().TableName, formatDateTime(utcNow(), 'yyyyMMddHHmmss'))",
														"type": "Expression"
													},
													"folderName": "Bronze"
												}
											}
										]
									},
									{
										"name": "update date",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "ingestion",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[sp_update_watermark]",
											"storedProcedureParameters": {
												"TableName": {
													"value": {
														"value": "@item().TableName",
														"type": "Expression"
													},
													"type": "String"
												},
												"WatermarkValue": {
													"value": {
														"value": "@utcNow()",
														"type": "Expression"
													},
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "SQL_Traning_KB",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						},
						{
							"name": "Check_New_Data",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Lookup-max-value",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT count(*) as NewRowCount FROM [dbo].[', item().TableName, '] WHERE LoadDateTime > ''', coalesce(formatDateTime(activity('Lookup-max-value').output.firstRow.WatermarkValue, 'yyyy-MM-dd HH:mm:ss.fff'), '1900-01-01 00:00:00.000'), '''')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlmetadata",
									"type": "DatasetReference"
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "kevin_bank"
		},
		"annotations": [],
		"lastPublishTime": "2025-10-02T17:43:14Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}